					"gradient": {
						"0.0": ["v.particle_random_1>0.5?1.0:0.35", "v.particle_random_1>0.5?0.45:0.85", "v.particle_random_1>0.5?0.15:1.0", 0],
						"0.15": ["v.particle_random_1>0.5?1.0:0.35", "v.particle_random_1>0.5?0.45:0.85", "v.particle_random_1>0.5?0.15:1.0", 0.9],
