			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size=0.15*(1-variable.particle_age/variable.particle_lifetime)+0.05;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.3, 0.6)"
			},
